{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:higgsfield": "node examples/higgsfield/setup.mjs",
    "example:higgsfield": "node examples/higgsfield/run.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "prepare:admin-browser-fixture": "node ./prepare-admin-browser-fixture.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ./test.mjs",
    "test:admin-access": "node ./test.mjs --admin-access"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@higgsfield/client": "^0.2.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
